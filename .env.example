DATABASE_URL=postgres://cscfeed_app:change-me@127.0.0.1:5432/cscfeed
MIGRATION_DATABASE_URL=postgres://cscfeed_owner:change-me@127.0.0.1:5432/cscfeed
# Local development only; production requires a strong password.
BOOTSTRAP_ADMIN_PASSWORD=admin123
# Required to encrypt new employee and Project Manager passwords for authorized viewing.
# Generate a private 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENCRYPTION_KEY=replace-with-64-hex-characters
PORT=5001
MAX_UPLOAD_BYTES=536870912
UPLOAD_DIR=storage/reports
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_NOTIFICATION_EMAILS=
