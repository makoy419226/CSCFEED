{
  "name": "project-reports",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-local-dev.js",
    "dev:local": "npm run dev",
    "dev:stack": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.js",
    "db:studio": "drizzle-kit studio --config=drizzle.config.js --host=127.0.0.1"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "vite": "^6.0.7"
  }
}
